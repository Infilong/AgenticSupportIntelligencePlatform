ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://agentic:agentic@localhost:5432/agentic_support
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic_support
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. Required only when an active model config uses provider=openai or openai-compatible.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
