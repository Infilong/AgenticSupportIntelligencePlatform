ENVIRONMENT=local
# Supported: local, development, test, staging, production.
# Staging/production require a randomly generated JWT_SECRET_KEY (at least 32 UTF-8 bytes).
# The default below is accepted only for local/development/test. Never deploy it.
DATABASE_URL=postgresql+psycopg://agentic:agentic@localhost:5432/agentic_support
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic_support
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Required for configured OpenAI/openai-compatible chat calls or EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30

# Semantic embeddings are opt-in, billed model calls. Default remains deterministic mock.
# OpenAI mode requires PostgreSQL migrations through 0028, an API key and an explicit current price.
# Reindex existing documents after changing provider/model/dimensions.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TOKEN_COST_PER_1K=
