{
  "name": "asi-rebuild-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Local multilingual support workbench",
  "type": "module",
  "scripts": {
    "test:environment": "playwright test tests/e2e/environment.spec.ts",
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:app": "playwright test tests/e2e/app.spec.ts",
    "generate:api": "openapi-typescript ../.artifacts/openapi.json -o src/api/schema.d.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  }
}
